{
  config,
  lib,
  dream2nix,
  ...
}: let
  rev = "88f9f1e5c896d08711fa10d03055146db89d2234";
  src = config.deps.fetchFromGitHub {
    owner = "PokeAPI";
    repo = "pokeapi";
    inherit rev;
    sha256 = "sha256-+QhuoMzVmm4wIRn2J4HbzW64TCssjzGZkuNh17b9CcM=";
    fetchSubmodules = true;
  };
in {
  imports = [
    dream2nix.modules.dream2nix.pip
  ];

  deps = {nixpkgs, ...}: {
    inherit (nixpkgs) fetchFromGitHub python313Packages;
  };

  name = "pokeapi";
  version = rev;

  mkDerivation = {
    inherit src;
    installPhase = ''
      mkdir -p $out
    '';
    buildPhase = ''
      make setup
      make build-db
      mkdir -p $out
      cp db.sqlite3 $out/
      cp -r data/v2/sprites/sprites $out/
    '';
  };

  buildPythonPackage = {
    pyproject = false;
  };

  # Usually this lock file generated by dream2nix needs to specify the system,
  # but all the dependencies should be system-independent.
  paths.lockFile = "pokeapi.lock.json";
  pip = {
    requirementsFiles = ["${src}/requirements.txt"];
    flattenDependencies = true;
  };
}
